# Vector Database Configuration
# Add this to your application.yml or application.properties

# Enable automatic embeddings initialization on startup (optional)
app.embeddings.auto-init=false  # Set to true to initialize embeddings on app start

# Vector embedding settings
spring.ai.embedding.model=openai  # Can be: openai, huggingface, local
app.embeddings.dimension=1536     # Embedding dimension (default: 1536)
app.embeddings.batch-size=100     # Batch size for bulk operations

# PostgreSQL pgvector configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/funds_analyser
spring.datasource.username=postgres
spring.datasource.password=your_password

# JPA/Hibernate configuration
spring.jpa.hibernate.ddl-auto=validate  # Don't auto-create schema, use Flyway instead
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.jdbc.batch_size=20

# Flyway configuration (handles schema migrations including vector tables)
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration

# Logging
logging.level.com.rms.funds.holdings.analyser.service.EmbeddingInitializationService=INFO
logging.level.com.rms.funds.holdings.analyser.agent.VectorEmbeddingAgent=INFO
logging.level.com.rms.funds.holdings.analyser.controller.EmbeddingController=DEBUG

# Optional: If using OpenAI embeddings
# spring.ai.openai.api-key=${OPENAI_API_KEY}
# spring.ai.openai.embedding-model.options.model=text-embedding-3-small

